# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local QA screenshots, browser reports and Figma previews
/docs/*previews/

# Temporary research/downloads (never publish member portraits)
/tmp/
/temp/
/research-downloads/
*.log

# Unused Create Next App demonstration assets (kept locally)
/public/file.svg
/public/globe.svg
/public/next.svg
/public/vercel.svg
/public/window.svg
