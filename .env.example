# Server-only Supabase Transaction pooler URI (Connect panel, port 6543).
# Replace placeholders, URL-encode the database password. Never use NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional PEM certificate downloaded from Supabase; literal \n is supported.
# DATABASE_SSL_CA=
# Maintenance only: Direct or Session pooler (5432), preferably schema owner.
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Generate: npm run admin:setup. Legacy salt:hash values are rejected.
ADMIN_PASSWORD_HASH=
# Required for production mutation origin checks (no trailing slash).
APP_ORIGIN=http://localhost:3003
# Tests only: dedicated disposable PostgreSQL database; never production!
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anargya_test
