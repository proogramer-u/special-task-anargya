{
  "name": "anargya-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:browser": "node tests/site-check.cjs",
    "test:commerce": "npm run test:db && npm run test:api",
    "test:pwa": "node tests/pwa-policy.cjs",
    "db:migrate": "node --conditions=react-server scripts/db-migrate.cjs",
    "db:seed": "node --conditions=react-server scripts/db-seed.cjs",
    "admin:setup": "node --conditions=react-server scripts/setup-admin.cjs",
    "test:db": "node --conditions=react-server tests/commerce-core.cjs",
    "test:api": "node --conditions=react-server tests/commerce-server.cjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
